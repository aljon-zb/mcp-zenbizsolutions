# =============================================================================
# UNIFIED MULTI-TENANT MCP
# One public MCP endpoint for all projects:
#   https://mycompany.com/mcp
#
# Existing projects:
#   1. PeltierPro
#   2. ZenBiz
#
# IMPORTANT:
# - The PUBLIC MCP URL is global, not per-project.
# - Odoo URLs/databases/API keys remain per-project because each tenant has
#   its own backend/integration credentials.
# - Do not commit this file after adding real secrets.
# =============================================================================

MCP_HOST=0.0.0.0
MCP_PORT=8000
MCP_TRANSPORT=streamable-http
MCP_PUBLIC_BASE_URL=https://mycompany.com
MCP_PUBLIC_PATH=/mcp
LOG_LEVEL=INFO
REQUEST_TIMEOUT_SECONDS=30
MAX_RESULTS=50

# ---------------------------------------------------------------------------
# IDENTITY MODE
# shared      = one AI account shared by multiple employees; your own login
#               layer identifies the employee
# individual  = each AI seat/user maps directly to an internal user
# hybrid      = supports both shared and individual seats
# ---------------------------------------------------------------------------
IDENTITY_MODE=hybrid

# ---------------------------------------------------------------------------
# PELTIERPRO
# ---------------------------------------------------------------------------
PELTIERPRO_CLIENT_ID=peltierpro
PELTIERPRO_CLIENT_NAME=PeltierPro

PELTIERPRO_ODOO_URL=https://odoo-stg.peltierpro.com
PELTIERPRO_ODOO_DATABASE=odoo-stg.peltierpro.com
PELTIERPRO_ODOO_USERNAME=
PELTIERPRO_ODOO_API_KEY=REQUIRED_REAL_VALUE

# Initial bootstrap identity until DB-backed user management is added.
PELTIERPRO_BOOTSTRAP_USER_ID=aljon
PELTIERPRO_BOOTSTRAP_USER_ROLE=mcp_admin

# ---------------------------------------------------------------------------
# ZENBIZ
# ---------------------------------------------------------------------------
ZENBIZ_CLIENT_ID=zenbiz
ZENBIZ_CLIENT_NAME=ZenBiz

ZENBIZ_ODOO_URL=https://zenbiz.odoo.com/
ZENBIZ_ODOO_DATABASE=zenbiz
ZENBIZ_ODOO_USERNAME=
ZENBIZ_ODOO_API_KEY=REQUIRED_REAL_VALUE

ZENBIZ_BOOTSTRAP_USER_ID=aljon
ZENBIZ_BOOTSTRAP_USER_ROLE=mcp_admin

# ---------------------------------------------------------------------------
# AUTH / OAUTH
# ---------------------------------------------------------------------------
# Leave disabled for local/bootstrap testing.
# Enable once your OAuth/SSO provider is ready.
AUTH_ENABLED=false
AUTH_ISSUER_URL=
AUTH_JWKS_URL=
AUTH_AUDIENCE=https://mycompany.com/mcp
AUTH_RESOURCE_SERVER_URL=https://mycompany.com
AUTH_REQUIRED_SCOPES=odoo.read
AUTH_ALGORITHMS=RS256

# Optional: shared-account employee login/session service
INTERNAL_LOGIN_ENABLED=true
INTERNAL_LOGIN_ISSUER=https://mycompany.com
INTERNAL_LOGIN_AUDIENCE=https://mycompany.com/mcp
